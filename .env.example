TELEGRAM_BOT_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=matservice@mitservice.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=
# Optional alternatives if your host cannot store GOOGLE_PRIVATE_KEY directly:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PRIVATE_KEY_BASE64=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=1cXyL60QniZevYOb06adN5FPHWN5tbYhiHX12yIa6kG4
ALLOWED_USERS=
ADMIN_USERS=@antoniotsd,@Cuervo0o0o,@talhapervaiz97
ADMIN_CHAT_IDS=
BENCHMARK_CRON_SECRET=

# Optional: shared secret echoed by Telegram in the
# X-Telegram-Bot-Api-Secret-Token header. When set, the webhook rejects
# requests that do not present the exact value. Pass the same value as
# secret_token when calling setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Optional: persistent store for sessions, approvals, admin chats and access
# requests (Upstash / Vercel KV REST). When unset the bot keeps state in memory
# only (reset on cold starts). Both URL and TOKEN are required to enable it.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash-native variable names are also accepted:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional cache window for Google Sheets reads (milliseconds, default 60000):
GOOGLE_SHEETS_CACHE_TTL_MS=

# Optional n8n ingestion (SQL-less). n8n reads each Google Sheet on a schedule
# and POSTs the rows to /api/ingest, which stores them in the Redis/KV (above)
# + in-memory dataset. The bot then reports from that dataset instead of reading
# every sheet live. See n8n/README.md.
# Shared secret required by the /api/ingest endpoint that n8n calls:
INGEST_SECRET=
# Data source selection: auto (default) | ingest | sheets.
#   auto   -> use ingested data when present, else read Google Sheets
#   ingest -> always use ingested data
#   sheets -> always read Google Sheets directly
LEADS_SOURCE=auto

# "Bot Authority" registry spreadsheet: an Offices tab that maps office x month
# to each data spreadsheet ID, plus a users tab. The bot reads it to discover
# which Google Sheets to use (GET/POST /api/sources). The service account must be
# shared on the registry AND on every office data sheet it lists.
GOOGLE_AUTHORITY_SPREADSHEET_ID=1mwnrhktfXR_E7R15-4uDDk4FG9euG27U5XhrbztsLBc
GOOGLE_AUTHORITY_OFFICES_TAB=Offices
GOOGLE_AUTHORITY_USERS_TAB=users
# Tab/range to read inside each office's monthly spreadsheet:
GOOGLE_AUTHORITY_DATA_TAB=Leads
GOOGLE_AUTHORITY_DATA_RANGE='Leads'!A:Y
# Authorize bot users from the Bot Authority "users" tab (in addition to
# ALLOWED_USERS/ADMIN_USERS). Reads Google Sheets, so it is opt-in + TTL-cached.
AUTHORIZE_FROM_REGISTRY=false
REGISTRY_USERS_TTL_MS=600000

GOOGLE_LEADS_TAB=Leads
GOOGLE_LEADS_RANGE='Leads'!A:Y
GOOGLE_FTD_TAB=FTD
GOOGLE_TRANSACTION_TAB=TRANSACTION
