TELEGRAM_BOT_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=matservice@mitservice.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=
# Optional alternatives if your host cannot store GOOGLE_PRIVATE_KEY directly:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PRIVATE_KEY_BASE64=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=1cXyL60QniZevYOb06adN5FPHWN5tbYhiHX12yIa6kG4
ALLOWED_USERS=
ADMIN_USERS=@antoniotsd,@Cuervo0o0o,@talhapervaiz97
ADMIN_CHAT_IDS=
BENCHMARK_CRON_SECRET=

# Optional: shared secret echoed by Telegram in the
# X-Telegram-Bot-Api-Secret-Token header. When set, the webhook rejects
# requests that do not present the exact value. Pass the same value as
# secret_token when calling setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Optional: persistent store for sessions, approvals, admin chats, access
# requests, and ingested CRM rows (Upstash / Vercel KV REST). When unset the
# bot keeps state in memory only (reset on cold starts). Both URL and TOKEN are
# required to enable REST mode.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative: standard Redis TCP URL (Redis Cloud, etc.). Example:
# REDIS_URL=redis://default:YOUR_PASSWORD@your-host.db.redis.io:PORT
# Do NOT commit real credentials. Use either KV REST *or* REDIS_URL.
REDIS_URL=
# Upstash-native variable names are also accepted:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional cache window for Google Sheets reads (milliseconds, default 60000):
GOOGLE_SHEETS_CACHE_TTL_MS=
# Optional cache window for generated bot Excel exports (ms, default 120000).
# Identical office/month/report exports are reused under concurrent load.
EXPORT_CACHE_TTL_MS=

# Optional n8n ingestion (SQL-less). n8n reads each Google Sheet on a schedule
# and POSTs the rows to /api/ingest, which stores them in the Redis/KV (above)
# + in-memory dataset. The bot then reports from that dataset instead of reading
# every sheet live. See n8n/README.md.
# Shared secret required by the /api/ingest endpoint that n8n calls:
INGEST_SECRET=
# Data source selection: auto (default) | ingest | sheets.
#   auto   -> use ingested data when present, else read Google Sheets
#   ingest -> always use ingested data
#   sheets -> always read Google Sheets directly
LEADS_SOURCE=auto
# Dashboard data source (falls back to LEADS_SOURCE when unset):
#   auto   -> Redis/n8n ingest when available, else Google Sheets
#   ingest -> dashboard always reads from Redis
#   sheets -> dashboard always reads Google Sheets live
DASHBOARD_SOURCE=auto

# Optional admin-only AI agent (Q&A over the report data), driven by n8n + OpenAI.
# The /api/ai endpoint resolves the question to an entity (agent / team leader /
# desk / country / campaign) and returns a compact JSON of facts; n8n forwards
# only that to OpenAI (token-efficient) and replies on Telegram. Out-of-scope
# questions are refused server-side without calling OpenAI. See n8n/README.md.
# Secret the /api/ai endpoint requires (falls back to INGEST_SECRET if unset):
AI_AGENT_SECRET=
# OpenAI API key + model. When set, the bot calls OpenAI directly to phrase the
# (already-aggregated) facts. Leave OPENAI_API_KEY empty to reply with the
# deterministic draft answer instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: keep the OpenAI key in n8n instead. Point this at an n8n Webhook that
# accepts { messages } and responds { text }; the bot will use it before falling
# back to a direct OpenAI call. See n8n/crm-ai-openai-relay.json.
AI_N8N_WEBHOOK_URL=
# Optional OpenAI-compatible base URL and reply timeout (ms).
OPENAI_BASE_URL=
AI_REPLY_TIMEOUT_MS=30000

# "Bot Authority" registry spreadsheet: an Offices tab that maps office x month
# to each data spreadsheet ID, plus a users tab. The bot reads it to discover
# which Google Sheets to use (GET/POST /api/sources). The service account must be
# shared on the registry AND on every office data sheet it lists.
GOOGLE_AUTHORITY_SPREADSHEET_ID=1mwnrhktfXR_E7R15-4uDDk4FG9euG27U5XhrbztsLBc
GOOGLE_AUTHORITY_OFFICES_TAB=Offices
GOOGLE_AUTHORITY_USERS_TAB=users
# Tab/range to read inside each office's monthly spreadsheet:
GOOGLE_AUTHORITY_DATA_TAB=Leads
GOOGLE_AUTHORITY_DATA_RANGE='Leads'!A:Y
# Authorize bot users from the Bot Authority "users" tab (in addition to
# ALLOWED_USERS/ADMIN_USERS). Reads Google Sheets, so it is opt-in + TTL-cached.
AUTHORIZE_FROM_REGISTRY=false
REGISTRY_USERS_TTL_MS=600000

GOOGLE_LEADS_TAB=Leads
GOOGLE_LEADS_RANGE='Leads'!A:Y
GOOGLE_FTD_TAB=FTD
GOOGLE_TRANSACTION_TAB=TRANSACTION
