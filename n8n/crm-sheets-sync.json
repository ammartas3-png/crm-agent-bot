{
  "name": "CRM Sheets Sync",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-360, 0]
    },
    {
      "parameters": {
        "jsExecMode": "once",
        "language": "javaScript",
        "jsCode": "// Paste the spreadsheet IDs from your Bot Authority > Offices tab.\n// Add 4 rows per office per month as needed. sourceKey must be stable so\n// re-syncs replace (not duplicate) the data.\nconst sources = [\n  { office: 'Turkiye Office',   period: '2026-01', spreadsheetId: 'PASTE_TURKIYE_JANUARY_ID' },\n  { office: 'Turkiye Office',   period: '2026-03', spreadsheetId: 'PASTE_TURKIYE_MARCH_ID' },\n  { office: 'Dubai Office',     period: '2026-03', spreadsheetId: 'PASTE_DUBAI_MARCH_ID' },\n  { office: 'Argentina Office', period: '2026-03', spreadsheetId: 'PASTE_ARGENTINA_MARCH_ID' },\n  { office: 'Pakistan Office',  period: '2026-01', spreadsheetId: 'PASTE_PAKISTAN_JANUARY_ID' }\n];\nreturn sources.map((s) => ({ json: { office: s.office, period: s.period, category: 'leads', spreadsheetId: s.spreadsheetId, sheetName: 'Leads', range: 'A:Y', sourceKey: s.office.toLowerCase().split(' ').join('-') + ':' + s.period + ':leads' } }));"
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Define Sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Loop Over Sources",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [60, 0]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $('Loop Over Sources').item.json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $('Loop Over Sources').item.json.sheetName }}",
          "mode": "name"
        },
        "options": {}
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Read Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [280, 0],
      "credentials": {
        "googleApi": {
          "id": "REPLACE_WITH_GOOGLE_CREDENTIAL_ID",
          "name": "Google Service Account"
        }
      }
    },
    {
      "parameters": {
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "",
              "renameField": true,
              "outputFieldName": "rows"
            }
          ]
        },
        "options": {}
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Aggregate Rows",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [500, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PUBLIC_APP_URL }}/api/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-ingest-secret",
              "value": "={{ $env.INGEST_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sourceKey: $('Loop Over Sources').item.json.sourceKey, office: $('Loop Over Sources').item.json.office, period: $('Loop Over Sources').item.json.period, category: $('Loop Over Sources').item.json.category, spreadsheetId: $('Loop Over Sources').item.json.spreadsheetId, sheetRange: $('Loop Over Sources').item.json.range, rows: $json.rows }) }}",
        "options": {}
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Push to /api/ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [[{ "node": "Define Sources", "type": "main", "index": 0 }]]
    },
    "Define Sources": {
      "main": [[{ "node": "Loop Over Sources", "type": "main", "index": 0 }]]
    },
    "Loop Over Sources": {
      "main": [
        [],
        [{ "node": "Read Google Sheet", "type": "main", "index": 0 }]
      ]
    },
    "Read Google Sheet": {
      "main": [[{ "node": "Aggregate Rows", "type": "main", "index": 0 }]]
    },
    "Aggregate Rows": {
      "main": [[{ "node": "Push to /api/ingest", "type": "main", "index": 0 }]]
    },
    "Push to /api/ingest": {
      "main": [[{ "node": "Loop Over Sources", "type": "main", "index": 0 }]]
    }
  }
}
