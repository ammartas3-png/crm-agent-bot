{
  "name": "CRM Registry Sync (simple)",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-420, 0]
    },
    {
      "parameters": {
        "jsExecMode": "once",
        "language": "javaScript",
        "jsCode": "const PUBLIC_APP_URL = 'https://crm-agent-bot-hj5k.vercel.app';\nconst INGEST_SECRET = 'PASTE_YOUR_INGEST_SECRET_FROM_VERCEL';\n\nreturn [{\n  json: {\n    publicAppUrl: String(PUBLIC_APP_URL || '').trim().replace(/\\/+$/, ''),\n    ingestSecret: String(INGEST_SECRET || '').trim(),\n  },\n}];"
      },
      "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaab",
      "name": "App Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('App Config').item.json.publicAppUrl }}/api/sources",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-ingest-secret",
              "value": "={{ $('App Config').item.json.ingestSecret }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
      "name": "Sync from Bot Authority",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 0]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [[{ "node": "App Config", "type": "main", "index": 0 }]]
    },
    "App Config": {
      "main": [[{ "node": "Sync from Bot Authority", "type": "main", "index": 0 }]]
    }
  }
}
